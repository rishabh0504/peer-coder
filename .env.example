# Supabase Storage S3 Configuration
SUPABASE_STORAGE_S3_URL="http://127.0.0.1:54321/storage/v1/s3"
SUPABASE_STORAGE_S3_ACCESS_KEY="your-supabase-s3-access-key"
SUPABASE_STORAGE_S3_SECRET_KEY="your-supabase-s3-secret-key"
SUPABASE_STORAGE_S3_REGION="local"

# Supabase Mailpit / Email Settings
MAILPIT_STUDIO_URL="http://127.0.0.1:54324"
SMTP_HOST="127.0.0.1"
SMTP_PORT=1025

# Supabase Additional APIs & Studio Dashboard
SUPABASE_STUDIO_URL="http://127.0.0.1:54323"
SUPABASE_REST_URL="http://127.0.0.1:54321/rest/v1"
SUPABASE_GRAPHQL_URL="http://127.0.0.1:54321/graphql/v1"
SUPABASE_EDGE_FUNCTIONS_URL="http://127.0.0.1:54321/functions/v1"

# Redis Configuration
