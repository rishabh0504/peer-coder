{
  "name": "peer-coder",
  "version": "1.0.0",
  "description": "Production-grade peer code agent",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "peer-coder": "./dist/cli.js"
  },
  "files": ["dist"],
  "packageManager": "pnpm@10.4.0",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node ./dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "link": "rimraf dist && pnpm build && pnpm link --global $(pwd)",
    "unlink": "pnpm unlink --global peer-coder",
    "prepare": "husky || true"
  },
  "keywords": ["cli", "template", "typescript", "node", "commander", "clack"],
  "author": "Rishabh Tiwari(rishabh.tiwari0504@gmail.com)",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "boxen": "^8.0.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@types/node": "^22.13.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "rimraf": "^6.1.3",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
